                            { "caption": "Heizung", "value": "heating" },
                            { "caption": "Sonstiges", "value": "other" },
                            { "caption": "Skripte", "value": "script" }
                        ]
                    }
                },
                {
                    "caption": "Bezeichnung",
                    "name": "Name",
                    "width": "auto",
                    "add": "",
                    "save": true
                }
            ],
            "form": [
                "return [",
                "    ['type' => 'Select', 'name' => 'Group', 'caption' => 'Gruppe', 'options' => [",
                "        ['caption' => 'Lampen', 'value' => 'light'],",
                "        ['caption' => 'Rollläden', 'value' => 'shutter'],",
                "        ['caption' => 'Heizung', 'value' => 'heating'],",
                "        ['caption' => 'Sonstiges', 'value' => 'other'],",
                "        ['caption' => 'Skripte', 'value' => 'script']",
                "    ]],",
                "    ['type' => 'ValidationTextBox', 'name' => 'Name', 'caption' => 'Bezeichnung', 'width' => '400px'],",
                "    ['type' => 'SelectAction', 'name' => 'Action', 'caption' => 'Aktion', 'width' => '600px']",
                "];"
            ]
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Aktionsliste ist bereit" },
        { "code": 201, "icon": "error", "caption": "Die Aktionsliste ist fehlerhaft" }
