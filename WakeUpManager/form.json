{
    "elements": [
        {
            "type": "SelectInstance",
            "name": "ActionInstance",
            "caption": "Central actions (WakeUpActions)",
            "validModules": [
                "{4E963960-1F66-A246-3BC9-BA42E525A6F7}"
            ]
        },
        {
            "type": "SelectIcon",
            "name": "Icon",
            "caption": "Tile icon (tap in the tile switches the alarm clock on/off)"
        }
    ],
    "actions": [
        {
            "type": "Label",
            "caption": "Settings of the alarm clock. Changes are saved immediately, also when made in the tile."
        },
        {
            "type": "CheckBox",
            "name": "Active",
            "caption": "Alarm clock active",
            "onChange": "IPS_RequestAction($id, 'SetActive', $Active);"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "SelectTime",
                    "name": "WakeUpTime",
                    "caption": "Wake-up time"
                },
                {
                    "type": "Button",
                    "caption": "Save wake-up time",
                    "onClick": "IPS_RequestAction($id, 'SetWakeUpTime', $WakeUpTime);"
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "SeparateWeekend",
            "caption": "Separate wake-up time for the weekend (Sat–Sun)",
            "onChange": "IPS_RequestAction($id, 'SetSeparateWeekend', $SeparateWeekend);"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "SelectTime",
                    "name": "WakeUpTimeWeekend",
                    "caption": "Wake-up time weekend"
                },
                {
                    "type": "Button",
                    "caption": "Save weekend wake-up time",
                    "onClick": "IPS_RequestAction($id, 'SetWakeUpTimeWeekend', $WakeUpTimeWeekend);"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Active weekdays"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "Monday",
                    "caption": "Mon",
                    "onChange": "IPS_RequestAction($id, 'SetWeekday', json_encode(['Day' => 1, 'Active' => $Monday]));"
                },
                {
                    "type": "CheckBox",
                    "name": "Tuesday",
                    "caption": "Tue",
                    "onChange": "IPS_RequestAction($id, 'SetWeekday', json_encode(['Day' => 2, 'Active' => $Tuesday]));"
                },
                {
                    "type": "CheckBox",
                    "name": "Wednesday",
                    "caption": "Wed",
                    "onChange": "IPS_RequestAction($id, 'SetWeekday', json_encode(['Day' => 3, 'Active' => $Wednesday]));"
                },
                {
                    "type": "CheckBox",
                    "name": "Thursday",
                    "caption": "Thu",
                    "onChange": "IPS_RequestAction($id, 'SetWeekday', json_encode(['Day' => 4, 'Active' => $Thursday]));"
                },
                {
                    "type": "CheckBox",
                    "name": "Friday",
                    "caption": "Fri",
                    "onChange": "IPS_RequestAction($id, 'SetWeekday', json_encode(['Day' => 5, 'Active' => $Friday]));"
                },
                {
                    "type": "CheckBox",
                    "name": "Saturday",
                    "caption": "Sat",
                    "onChange": "IPS_RequestAction($id, 'SetWeekday', json_encode(['Day' => 6, 'Active' => $Saturday]));"
                },
                {
                    "type": "CheckBox",
                    "name": "Sunday",
                    "caption": "Sun",
                    "onChange": "IPS_RequestAction($id, 'SetWeekday', json_encode(['Day' => 7, 'Active' => $Sunday]));"
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Templates (e.g. early and late shift): wake-up times, weekdays and action selection"
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Select",
                    "name": "TemplateSelect",
                    "caption": "Template",
                    "options": []
                },
                {
                    "type": "Button",
                    "name": "TemplateLoad",
                    "caption": "Load template",
                    "onClick": "IPS_RequestAction($id, 'LoadTemplate', json_encode(['Name' => $TemplateSelect, 'Source' => 'console']));"
                },
                {
                    "type": "Button",
                    "name": "TemplateOverwrite",
                    "caption": "Overwrite template",
                    "confirm": "Overwrite the selected template with the current settings?",
                    "onClick": "IPS_RequestAction($id, 'SaveTemplate', json_encode(['Name' => $TemplateSelect, 'Source' => 'console']));"
                },
                {
                    "type": "Button",
                    "name": "TemplateDelete",
                    "caption": "Delete template",
                    "confirm": "Delete the selected template?",
                    "onClick": "IPS_RequestAction($id, 'DeleteTemplate', json_encode(['Name' => $TemplateSelect, 'Source' => 'console']));"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "TemplateName",
                    "caption": "Name of the new template"
                },
                {
                    "type": "Button",
                    "caption": "Save current settings as template",
                    "onClick": "IPS_RequestAction($id, 'SaveTemplate', json_encode(['Name' => $TemplateName, 'Source' => 'console']));"
                }
            ]
        },
        {
            "type": "Label",
            "name": "ActionsHint",
            "caption": "",
            "visible": false
        },
        {
            "type": "List",
            "name": "ActionsLight",
            "caption": "Lights",
            "rowCount": 4,
            "add": false,
            "delete": true,
            "columns": [
                {
                    "caption": "Action",
                    "name": "Name",
                    "width": "auto"
                },
                {
                    "caption": "Execute",
                    "name": "Active",
                    "width": "110px",
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Condition",
                    "name": "Condition",
                    "width": "110px"
                },
                {
                    "name": "ID",
                    "visible": false
                }
            ],
            "values": [],
            "onEdit": "IPS_RequestAction($id, 'SetAction', json_encode($ActionsLight));",
            "onDelete": "IPS_RequestAction($id, 'DeleteAction', $ActionsLight['ID']);"
        },
        {
            "type": "List",
            "name": "ActionsShutter",
            "caption": "Shutters",
            "rowCount": 4,
