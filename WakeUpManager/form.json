                    "width": "110px"
                },
                {
                    "caption": "Offset",
                    "name": "Offset",
                    "width": "160px",
                    "align": "right",
                    "edit": {
                        "type": "NumberSpinner",
                        "suffix": " min",
                        "minimum": -1440,
                        "maximum": 1440
                    }
                },
                {
                    "name": "ID",
                    "visible": false
                }
            ],
            "values": [],
            "onEdit": "IPS_RequestAction($id, 'SetAction', json_encode($ActionsHeating));",
            "onDelete": "IPS_RequestAction($id, 'DeleteAction', $ActionsHeating['ID']);"
        },
